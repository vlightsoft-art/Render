{
  "info": {
    "_postman_id": "6c34a4f5-7d7b-4f7e-9ee9-18d798c3a1f1",
    "name": "FamFin AI Gateway - Render",
    "description": "Postman collection for the FamFin AI Gateway middleware.\n\nSet collection variables:\n- baseUrl: your Render service URL, e.g. https://famfin-ai-gateway.onrender.com\n- appToken: the same FAMFIN_AI_APP_TOKEN configured in Render\n- householdId: optional household identifier\n\nFlutter talks only to this middleware. OpenAI and MongoDB credentials stay server-side.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://YOUR-RENDER-SERVICE.onrender.com",
      "type": "string"
    },
    {
      "key": "appToken",
      "value": "YOUR_FAMFIN_AI_APP_TOKEN",
      "type": "string"
    },
    {
      "key": "householdId",
      "value": "hh_test_001",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{appToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Render Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/healthz",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "healthz"
          ]
        },
        "description": "Unauthenticated health endpoint intended for Render health checks."
      },
      "response": []
    },
    {
      "name": "AI Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-FamFin-Client",
            "value": "famfin-app",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/ai/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "ai",
            "health"
          ]
        },
        "description": "App-facing authenticated health check."
      },
      "response": []
    },
    {
      "name": "AI Chat - Streaming",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "text/event-stream",
            "type": "text"
          },
          {
            "key": "X-FamFin-Client",
            "value": "famfin-app",
            "type": "text"
          },
          {
            "key": "X-FamFin-Household",
            "value": "{{householdId}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"default\",\n  \"stream\": true,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"How much can I safely spend this month?\"\n    }\n  ],\n  \"context\": {\n    \"currency\": \"INR\",\n    \"hasIncome\": true,\n    \"monthlyIncome\": 85000.0,\n    \"monthlyRegularIncome\": 80000.0,\n    \"monthlyVariableIncome\": 5000.0,\n    \"remainingExpectedIncome\": 0.0,\n    \"incomeSourceCount\": 2,\n    \"incomeEarnerCount\": 2,\n    \"liquidBalance\": 96000.0,\n    \"hasExpenseData\": true,\n    \"monthTotalSpend\": 41200.0,\n    \"monthEssentialSpend\": 28000.0,\n    \"monthLifestyleSpend\": 13200.0,\n    \"monthlyCommittedBills\": 12400.0,\n    \"outstandingBillCount\": 3,\n    \"overdueCount\": 1,\n    \"overdueTotal\": 2400.0,\n    \"unpaidCommitments\": 9800.0,\n    \"expectedRecovery\": 8400.0,\n    \"accountCount\": 4,\n    \"safeToSpend\": 12400.0,\n    \"protectedAmount\": 18000.0,\n    \"assumptions\": [\n      \"Salary credited on the 1st\",\n      \"Variable income excluded\"\n    ],\n    \"missingData\": [\n      \"No bill history for utilities\"\n    ],\n    \"hasDebt\": true,\n    \"totalDebt\": 480000.0,\n    \"monthlyDebtService\": 18400.0,\n    \"loanCount\": 2,\n    \"cardCount\": 3,\n    \"creditCardOutstanding\": 14200.0,\n    \"debtToIncome\": 0.216,\n    \"debtStrategy\": \"avalanche\",\n    \"investmentValue\": 320000.0,\n    \"investmentCount\": 6,\n    \"monthlyInvestmentContribution\": 9000.0,\n    \"totalAssetValue\": 1500000.0,\n    \"netWorth\": 1421800.0,\n    \"goalCount\": 4,\n    \"activeGoalCount\": 3,\n    \"goalsOnTrack\": 2,\n    \"monthlyGoalContributions\": 7000.0,\n    \"emergencyConfigured\": true,\n    \"emergencyReserve\": 68000.0,\n    \"emergencyTarget\": 130000.0,\n    \"emergencyShortfall\": 62000.0,\n    \"emergencyMonths\": 2.4,\n    \"policyCount\": 3,\n    \"monthlyPremium\": 2400.0,\n    \"annualPremium\": 28800.0,\n    \"renewalsDueSoon\": 1,\n    \"healthScore\": 68,\n    \"healthLabel\": \"Building stability\",\n    \"healthRisks\": [\n      \"Emergency fund: covers 2.4 months, target 6\",\n      \"Credit utilisation: 61% of limit in use\"\n    ]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/ai/chat",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "ai",
            "chat"
          ]
        },
        "description": "Main streaming chat endpoint. The response is Server-Sent Events (SSE) and should end with `data: [DONE]`."
      },
      "response": []
    },
    {
      "name": "AI Extract - OCR Text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-FamFin-Client",
            "value": "famfin-app",
            "type": "text"
          },
          {
            "key": "X-FamFin-Household",
            "value": "{{householdId}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"documentType\": \"receipt\",\n  \"mimeType\": \"image/jpeg\",\n  \"extractedText\": \"RELIANCE FRESH 14/08/26 TOTAL 1,284.50\",\n  \"expectedFields\": [\n    \"merchant\",\n    \"date\",\n    \"totalAmount\",\n    \"currency\",\n    \"category\",\n    \"taxAmount\"\n  ],\n  \"hints\": {\n    \"currency\": \"INR\",\n    \"locale\": \"en_IN\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/ai/extract",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "ai",
            "extract"
          ]
        },
        "description": "Document extraction using OCR text already generated on-device."
      },
      "response": []
    },
    {
      "name": "AI Extract - Base64 Document Template",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-FamFin-Client",
            "value": "famfin-app",
            "type": "text"
          },
          {
            "key": "X-FamFin-Household",
            "value": "{{householdId}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"documentType\": \"receipt\",\n  \"mimeType\": \"image/jpeg\",\n  \"contentBase64\": \"<PASTE_BASE64_BYTES_HERE>\",\n  \"expectedFields\": [\n    \"merchant\",\n    \"date\",\n    \"totalAmount\",\n    \"currency\",\n    \"category\",\n    \"taxAmount\"\n  ],\n  \"hints\": {\n    \"currency\": \"INR\",\n    \"locale\": \"en_IN\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/ai/extract",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "ai",
            "extract"
          ]
        },
        "description": "Document extraction template using Base64-encoded document bytes."
      },
      "response": []
    },
    {
