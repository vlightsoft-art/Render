# Server / Render
NODE_ENV=production
# Render sets PORT automatically. Do not set PORT in Render unless needed locally.
PORT=10000
REGION=render

# FamFin app-to-middleware authorization.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FAMFIN_AI_APP_TOKEN=replace_with_a_long_random_token

# OpenAI - server side only
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EXTRACT_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_EXTRACT_MAX_OUTPUT_TOKENS=1800
UPSTREAM_TIMEOUT_MS=85000

# MongoDB Atlas - server side only
# IMPORTANT: URL encode special characters in the username/password.
MONGODB_URI=mongodb+srv://vlightsoft_db_user:mJRTw3UYa1cj5j57@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=familyfinanceapp

# Quota behavior
ENFORCE_QUOTA=true
DEFAULT_EDITION=plus
# The supplied contract gives plus examples of 200 AI questions and 50 auto scans.
QUOTA_PLUS_AI=200
QUOTA_PLUS_SCANS=50
# Blank means unlimited. Set these before using free/family server-side editions.
QUOTA_FREE_AI=
QUOTA_FREE_SCANS=
QUOTA_FAMILY_AI=
QUOTA_FAMILY_SCANS=

# Request limits
RATE_LIMIT_PER_MINUTE=60
JSON_BODY_LIMIT=12mb
MAX_DOCUMENT_BYTES=8388608
MAX_HISTORY_MESSAGES=20
MAX_MESSAGE_CHARS=12000

# CORS. Flutter mobile is not affected. For Flutter Web, use comma-separated origins.
# Empty means allow all origins (convenient for development).
CORS_ORIGINS=

# Privacy: this service does not persist chat messages.
STORE_CHAT_LOGS=false
