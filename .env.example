# =============================================================================
# FAMFIN UNIFIED API - ONE RENDER SERVICE
# =============================================================================
NODE_ENV=production
# Render supplies PORT automatically. For local use you may set PORT=10000.
PORT=10000

# MongoDB Atlas - shared by Data API and AI Gateway
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=family_finance

# -----------------------------------------------------------------------------
# DATA / AUTH API
# -----------------------------------------------------------------------------
# Optional app-to-server header token used as x-app-token by Flutter.
FAMFIN_APP_TOKEN=CHANGE_TO_A_LONG_RANDOM_VALUE

# User access JWT signing secret (different from all other secrets).
JWT_ACCESS_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Export signed-link secret.
EXPORT_SIGNING_SECRET=CHANGE_TO_ANOTHER_LONG_RANDOM_VALUE
PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
EXPORT_WORKER_INTERVAL_MS=5000

# Optional OAuth providers.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Optional server-side subscription verification adapter.
SUBSCRIPTION_VERIFIER_URL=
SUBSCRIPTION_VERIFIER_TOKEN=

# -----------------------------------------------------------------------------
# AI GATEWAY
# -----------------------------------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EXTRACT_MODEL=gpt-5.6-luna

# AI gateway Bearer token. This is intentionally separate from user access JWTs.
FAMFIN_AI_APP_TOKEN=CHANGE_TO_A_LONG_RANDOM_AI_GATEWAY_TOKEN
REGION=render

ENFORCE_QUOTA=true
DEFAULT_EDITION=plus
QUOTA_FREE_AI=20
QUOTA_FREE_SCANS=3
QUOTA_PLUS_AI=200
QUOTA_PLUS_SCANS=50
# Use 'unlimited' for no family cap.
QUOTA_FAMILY_AI=unlimited
QUOTA_FAMILY_SCANS=unlimited
STORE_CHAT_LOGS=false

OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_EXTRACT_MAX_OUTPUT_TOKENS=1800
MAX_HISTORY_MESSAGES=20
MAX_MESSAGE_CHARS=12000
MAX_DOCUMENT_BYTES=8388608
RATE_LIMIT_PER_MINUTE=60

# Human-sized SSE chunks.
STREAM_MIN_CHARS=28
STREAM_TARGET_CHARS=72
STREAM_MAX_CHARS=150
STREAM_MAX_WAIT_MS=300

# -----------------------------------------------------------------------------
# SHARED HTTP
# -----------------------------------------------------------------------------
JSON_BODY_LIMIT=12mb
CORS_ORIGINS=*
